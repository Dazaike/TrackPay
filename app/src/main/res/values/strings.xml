    <string name="privacy_title">Privacy</string>
    <string name="privacy_body">TrackPay is local-first. Your jobs, rates, shifts, goals, and themes stay on this device. There is no account and no cloud sync in v1.</string>
    <string name="privacy_location">Location is optional. When enabled, it is used only for on-device geofence suggestions (arrive/leave). It is not sold, and it is not payroll truth.</string>
    <string name="privacy_notifications">Notifications show live session status while you are clocked in. You can deny notification permission and still use the app.</string>

    <string name="about_title">About</string>
    <string name="about_version">Version %1$s (%2$d)</string>
    <string name="about_body">Your shift, priced by the second. Clock in, watch earnings tick, fund goals, and unlock cosmetic themes by working — not by paying.</string>
    <string name="about_free">Every feature is free. No Pro tier. No widgets module. No Wear companion in v1.</string>

    <string name="onboarding_title">Welcome</string>
    <string name="onboarding_welcome_title">Your hours, live</string>
    <string name="onboarding_welcome_body">TrackPay turns a shift into a live ticker. Clock in, watch dollars climb, and park a cut into goals — all on device.</string>
    <string name="onboarding_get_started">Get started</string>
    <string name="onboarding_job_title">Create your first job</string>
    <string name="onboarding_job_body">Name it and set the hourly rate. You can add more jobs later in Settings.</string>
    <string name="onboarding_goal_title">Optional first goal</string>
    <string name="onboarding_goal_body">Pick a template or type your own. Skip if you just want the timer.</string>
    <string name="onboarding_goal_custom">Custom goal</string>
